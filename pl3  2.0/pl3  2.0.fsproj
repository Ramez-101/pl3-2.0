<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>StoreSimulator</RootNamespace>
  </PropertyGroup>

  <!-- 
    PROJECT STRUCTURE:
    ==================
    /Core       - Core types and domain models
    /Services   - Business logic and services  
    /Data       - Data access and persistence
    /UI         - User interface (Console & GUI)
  -->

  <ItemGroup>
    <!-- Core Layer - Domain Types -->
    <Compile Include="Core\Types.fs" />
    
    <!-- Services Layer - Business Logic -->
    <Compile Include="Services\UserManager.fs" />
    <Compile Include="Services\Auth.fs" />
    <Compile Include="Services\PriceCalculator.fs" />
    <Compile Include="Services\SearchFilter.fs" />
    
    <!-- Data Layer - Data Access -->
    <Compile Include="Data\Catalog.fs" />
    <Compile Include="Data\Cart.fs" />
    <Compile Include="Data\FileManager.fs" />
    
    <!-- UI Layer - User Interface -->
    <Compile Include="UI\ConsoleUI.fs" />
    <Compile Include="UI\StoreGui.fs" />
    
    <!-- Application Entry Point -->
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FSharp.SystemTextJson" Version="1.3.13" />
    <PackageReference Include="Avalonia" Version="11.0.10" />
    <PackageReference Include="Avalonia.Desktop" Version="11.0.10" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.0.10" />
  </ItemGroup>

</Project>
